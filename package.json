{
  "name": "owiki-sync",
  "version": "1.0.10",
  "description": "Sync notes across devices on your own server, browse them as a personal wiki, and let your AI agent read and write the vault.",
  "main": "main.js",
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --no-warnings src/reconcile.test.ts"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "sync"
  ],
  "author": "johnhom",
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.28.2",
    "obsidian": "^1.13.1",
    "typescript": "^7.0.2",
    "@types/node": "^26.2.0"
  }
}